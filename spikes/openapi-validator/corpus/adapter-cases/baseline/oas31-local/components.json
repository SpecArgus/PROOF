{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Pet": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer"
        }
      }
    },
    "PetList": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Pet"
      }
    }
  }
}
