        "findingCount": 1,
        "source": "level-3.yaml",
        "line": 1,
        "column": 1,
        "pointer": "/$ref",
        "filesRead": 4
      },
      "requiresLocation": true,
      "repeat": 5,
      "securityRationale": "Bounding reference depth prevents adversarial chains from exhausting stack, CPU, or resolver work."
    },
    {
