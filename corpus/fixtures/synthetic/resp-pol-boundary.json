{
  "openapi": "3.0.3",
  "info": {
    "title": "RESP and POL boundary cases",
    "version": "1.0.0"
  },
  "paths": {
    "/cache/{key}": {
      "put": {
        "operationId": "setCacheEntry",
        "summary": "Set a cache entry",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The cache key.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteCacheEntry",
        "summary": "Delete a cache entry",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The cache key.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/roles": {
      "get": {
        "operationId": "listRoles",
        "summary": "List available roles",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
