{
  "openapi": "3.0.3",
  "info": {
    "title": "AGT-RESP-001 corpus cases (OAS 3.0.x)",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/archive/{entryId}": {
      "delete": {
        "operationId": "pruneEntry",
        "summary": "Remove an archived entry",
        "x-agent-policy": {
          "confirmation": {
            "mode": "required"
          }
        },
        "parameters": [
          {
            "name": "entryId",
            "in": "path",
            "required": true,
            "description": "Archived entry identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/records/{recordId}": {
      "put": {
        "operationId": "replaceRecord",
        "summary": "Replace a record entirely",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "description": "Record identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/subscriptions": {
      "post": {
        "operationId": "createSubscription",
        "summary": "Create a new subscription",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/configs/{configId}": {
      "put": {
        "operationId": "replaceConfig",
        "summary": "Replace a configuration entry",
        "parameters": [
          {
            "name": "configId",
            "in": "path",
            "required": true,
            "description": "Configuration key.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "4XX": {
            "description": "Client error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/settings/{settingId}": {
      "patch": {
        "operationId": "updateSetting",
        "summary": "Update a configuration setting",
        "parameters": [
          {
            "name": "settingId",
            "in": "path",
            "required": true,
            "description": "Setting identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["error"],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}/credentials": {
      "get": {
        "operationId": "getUserCredentials",
        "summary": "List credentials for a user",
        "x-agent-policy": {
          "dataClassification": "confidential"
        },
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "User identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
