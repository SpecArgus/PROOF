{
  "openapi": "3.0.3",
  "info": {
    "title": "AGT-POL-001 corpus cases (OAS 3.0.x)",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/cache": {
      "delete": {
        "operationId": "flushCache",
        "summary": "Flush the application cache",
        "responses": {
          "204": {
            "description": "Flushed"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/permissions": {
      "post": {
        "operationId": "setEntitlement",
        "summary": "Grant an entitlement permission",
        "x-agent-policy": {
          "authorization": {
            "roles": ["admin"]
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks/actions": {
      "post": {
        "operationId": "cancelTask",
        "summary": "Cancel a pending task",
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payments/{paymentId}": {
      "delete": {
        "operationId": "voidPayment",
        "summary": "Void a payment transaction",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "Payment identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Voided"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "post": {
        "operationId": "createInvoice",
        "summary": "Create a billing invoice",
        "x-agent-policy": {
          "confirmation": {
            "mode": "not-required",
            "reason": "Invoice creation is a bookkeeping record only; the charge is applied separately through the billing workflow."
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/grants": {
      "post": {
        "operationId": "createGrant",
        "summary": "Create an authorization grant",
        "x-agent-policy": {
          "confirmation": {
            "mode": "conditional"
          },
          "authorization": {
            "roles": ["admin"]
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/purges": {
      "post": {
        "operationId": "executeCleanup",
        "summary": "Purge stale data records",
        "x-agent-policy": {
          "confirmation": {
            "mode": "not-required"
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
