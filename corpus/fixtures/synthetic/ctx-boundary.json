{
  "openapi": "3.0.3",
  "info": {
    "title": "CTX boundary cases",
    "version": "1.0.0"
  },
  "paths": {
    "/export": {
      "post": {
        "operationId": "exportData",
        "responses": {
          "202": {
            "description": "Export started"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Get service status",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/config": {
      "patch": {
        "summary": "Update config",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
