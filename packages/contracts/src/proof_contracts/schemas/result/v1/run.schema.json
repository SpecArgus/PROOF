{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specargus.github.io/PROOF/schemas/result/v1/run.schema.json",
  "title": "PROOF normalized run v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "evaluationTime",
    "status",
    "resultDigest",
    "findings",
    "errors",
    "summary",
    "gate",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evaluationTime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "completed",
        "input-error",
        "internal-error"
      ]
    },
    "resultDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/terminalError"
      }
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/summary"
    },
    "gate": {
      "$ref": "gate.schema.json"
    },
    "provenance": {
      "$ref": "provenance.schema.json"
    }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9._-]*$": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 0
          },
          "gate": {
            "properties": {
              "outcome": {
                "enum": [
                  "pass",
                  "advisory",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "input-error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1,
            "items": {
              "properties": {
                "kind": {
                  "enum": [
                    "input",
                    "configuration"
                  ]
                }
              }
            }
          },
          "gate": {
            "properties": {
              "outcome": {
                "const": "not-evaluated"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "internal-error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1,
            "items": {
              "properties": {
                "kind": {
                  "enum": [
                    "timeout",
                    "dependency",
                    "protocol",
                    "sandbox",
                    "internal"
                  ]
                }
              }
            }
          },
          "gate": {
            "properties": {
              "outcome": {
                "const": "not-evaluated"
              }
            }
          }
        }
      }
    }
  ]
}
