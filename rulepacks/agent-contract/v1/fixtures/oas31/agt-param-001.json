{
  "openapi": "3.1.1",
  "info": {
    "title": "AGT-PARAM-001 OAS 3.1 cases",
    "version": "1.0.0"
  },
  "paths": {
    "/users/{userId}": {
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "description": "Stable user identifier.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getUser",
        "summary": "Get a user",
        "responses": {
          "200": {
            "description": "User"
          }
        }
      }
    },
    "/admin": {
      "get": {
        "operationId": "getAdminHome",
        "summary": "Get the admin home resource",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Admin home"
          }
        }
      }
    }
  }
}
