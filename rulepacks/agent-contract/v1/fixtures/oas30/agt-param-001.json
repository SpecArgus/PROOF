{
  "openapi": "3.0.3",
  "info": {
    "title": "AGT-PARAM-001 OAS 3.0 cases",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List orders",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders"
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get an order",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "Stable order identifier assigned at creation.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order"
          }
        }
      }
    }
  }
}
