{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specargus.github.io/PROOF/schemas/rulepack/agent-contract/v1/agent-policy.schema.json",
  "title": "PROOF x-agent-policy v1",
  "type": "object",
  "properties": {
    "risks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "destructive",
          "financial_action",
          "external_side_effect",
          "permission_change",
          "sensitive_data"
        ]
      }
    },
    "confirmation": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "required",
            "conditional",
            "not-required"
          ]
        },
        "condition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "conditional"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "condition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "not-required"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "authorization": {
      "type": "object",
      "required": [
        "roles"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      },
      "patternProperties": {
        "^x-[a-z0-9][a-z0-9._-]*$": {}
      },
      "additionalProperties": false
    },
    "dataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    }
  },
  "patternProperties": {
    "^x-[a-z0-9][a-z0-9._-]*$": {}
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  }
}
